# Get a free token at https://www.courtlistener.com/sign-in/
# Without a token, requests are limited to ~100/day
COURTLISTENER_TOKEN=your_token_here

# Get a free API key at https://api.congress.gov/sign-up/
CONGRESS_API_KEY=your_key_here

# Get a free API key at https://api.data.gov/signup/ (used for the govinfo API)
GOV_INFO_KEY=your_key_here

# Optional: where bulk downloads are kept (govinfo zips). Default: ../gov-graph-data beside the repo.
# GOVGRAPH_DATA_DIR=/absolute/path/to/gov-graph-data

# Contact address for BLS bulk downloads (fetch-bls-bulk.js); BLS refuses scripts without one
BLS_CONTACT_EMAIL=you@example.com

# The user every visitor acts as until there is sign-in (favorites). Create one with
#   node --env-file=server/.env server/seed/create-user.js --name "Your name"
# CURRENT_USER_ID=00000000-0000-0000-0000-000000000000
